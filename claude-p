#!/usr/bin/env python3
"""
claude-p — drop-in wrapper for `claude -p` (non-interactive Claude CLI).

Logs every call to ~/apps/claude-p-wrapper/logs/claude-p-usage.log as JSON lines:
  {"ts": "...", "caller": "...", "prompt_chars": N, "elapsed_s": N.N, "exit_code": N, "count_this_hour": N}

Two-tier rate alerting:
  100/hour  — warning email (call still proceeds)
  400/hour  — critical email + call is suppressed (returns exit 0, empty stdout)

Emails are sent via the Gmail API using ~/apps/gmail-helper/token.json.
An email is sent at most once per hour per tier to avoid flooding.

Usage (identical to `claude -p` without the `-p` flag):
  claude-p [flags] "prompt text"
  claude-p [flags] < stdin_prompt

Scripts should call this instead of `claude -p`. This wrapper prepends `-p` automatically.
"""

import base64
import email.mime.text
import hashlib
import json
import os
import socket
import subprocess
import platform
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

WRAPPER_VERSION = 6
LOG_TZ = ZoneInfo("America/Denver")  # Utah Mountain Time, DST-aware

# ── Config ────────────────────────────────────────────────────────────────────

REPO_DIR    = Path(__file__).resolve().parent
LOG_FILE    = REPO_DIR / "logs/claude-p-usage.log"
RATE_FILE   = Path("/tmp/claude-p-rate")        # "YYYY-MM-DDTHH,count"
ALERT_FILE  = Path("/tmp/claude-p-alert")       # "YYYY-MM-DDTHH,tier" — last email sent
ALERT_TO    = "you@example.com"
NOTIFY      = Path.home() / "apps" / "gmail-notify" / "send-email.py"

WARN_LIMIT  = 100   # send warning email, call proceeds
HARD_LIMIT  = 400   # send critical email, call is suppressed

# Callers that bypass HARD_LIMIT suppression. Reserved for event-driven,
# low-volume callers where every call corresponds to a real user action
# (e.g. one screenshot = one rename). Timer-driven callers must not be exempted.
EXEMPT_CALLERS = {"rename.py"}

# ── Rate tracking ─────────────────────────────────────────────────────────────

def current_hour_key() -> str:
    return datetime.now().strftime("%Y-%m-%dT%H")

def get_count() -> int:
    key = current_hour_key()
    try:
        if RATE_FILE.exists():
            stored_key, n = RATE_FILE.read_text().strip().split(",", 1)
            return int(n) if stored_key == key else 0
    except Exception:
        pass
    return 0

def increment_count() -> int:
    key = current_hour_key()
    count = get_count() + 1
    try:
        RATE_FILE.write_text(f"{key},{count}")
    except Exception:
        pass
    return count

# ── Gmail alert ───────────────────────────────────────────────────────────────

def send_alert_email(subject: str, body: str):
    """Shell out to the canonical notify wrapper at gmail-notify/send-email.py.

    Replaces an earlier inline Resend POST that defaulted to a wrong sender
    (`noreply@example.com`) and a wrong recipient (`you@example.com`),
    landing alerts in the DDXWeb mailbox instead of James's primary inbox.
    The wrapper signs from `bot@example.com` and ships to
    `you@example.com` per the Notify-James Pattern SOP.

    Per SOP we do not pass the API key here — send-email.py reads RESEND_API_KEY
    from env. We keep failure surfacing identical (write to /tmp/claude-p-email.log)
    so the wrapper never crashes the host claude -p call on a transient send error.
    """
    try:
        proc = subprocess.run(
            ["python3", str(NOTIFY), "--to", ALERT_TO, "--subject", subject, "--body", body],
            capture_output=True, text=True, timeout=15,
        )
        if proc.returncode != 0:
            with open("/tmp/claude-p-email.log", "a") as f:
                f.write(
                    f"[{datetime.now(LOG_TZ).isoformat()}] notify rc={proc.returncode} "
                    f"stderr={proc.stderr.strip()[:300]!r}\n"
                )
    except Exception as e:
        try:
            with open("/tmp/claude-p-email.log", "a") as f:
                f.write(f"[{datetime.now(LOG_TZ).isoformat()}] notify failed: {e}\n")
        except Exception:
            pass

def maybe_alert(count: int, caller: str):
    """Send an email alert if we just crossed a threshold — at most once per hour per tier."""
    key = current_hour_key()
    try:
        stored = ALERT_FILE.read_text().strip() if ALERT_FILE.exists() else ""
        stored_key, stored_tier = stored.split(",", 1) if "," in stored else ("", "")
    except Exception:
        stored_key, stored_tier = "", ""

    tier = None
    if count == HARD_LIMIT:
        tier = "critical"
    elif count == WARN_LIMIT:
        tier = "warning"

    if tier is None:
        return

    if stored_key == key and stored_tier == tier:
        return  # already emailed this tier this hour

    ALERT_FILE.write_text(f"{key},{tier}")

    hour_label = datetime.now().strftime("%-I %p")
    if tier == "critical":
        subject = f"[claude-p] CRITICAL: {count} calls this hour — suppressing further calls"
        body = (
            f"claude -p has been called {count} times this hour (threshold: {HARD_LIMIT}).\n\n"
            f"Caller that triggered: {caller}\n"
            f"Hour: {hour_label}\n\n"
            f"Further calls are now suppressed until the next clock-hour.\n"
            f"Run: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1\n"
            f"to see the full breakdown."
        )
    else:
        subject = f"[claude-p] WARNING: {count} calls this hour"
        body = (
            f"claude -p has been called {count} times this hour (warning threshold: {WARN_LIMIT}).\n\n"
            f"Caller that triggered: {caller}\n"
            f"Hour: {hour_label}\n\n"
            f"Calls are still proceeding. Hard limit is {HARD_LIMIT}/hour.\n"
            f"Run: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1\n"
            f"to see the full breakdown."
        )

    send_alert_email(subject, body)

# ── Caller detection ──────────────────────────────────────────────────────────

def detect_caller() -> str:
    try:
        ppid = os.getppid()
        out = subprocess.check_output(
            ["ps", "-p", str(ppid), "-o", "command="], text=True, timeout=2
        ).strip()
        parts = out.split()
        for part in parts:
            if part.endswith((".py", ".sh")):
                return Path(part).name
        return parts[0] if parts else "unknown"
    except Exception:
        return "unknown"

# ── Logging ───────────────────────────────────────────────────────────────────

def log(entry: dict):
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(json.dumps(entry) + "\n")

# ── Main ──────────────────────────────────────────────────────────────────────

def parse_model(args):
    """Extract --model value from argv, or return 'default'."""
    for i, a in enumerate(args):
        if a == "--model" and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--model="):
            return a.split("=", 1)[1]
    return "default"


def process_ancestry(max_depth=6):
    """Walk up the process tree. Returns a list of short command names
    from parent → ancestor, e.g. ['nudge_ai_classify.py', 'nudge-clear-on-stop.sh', 'claude']."""
    chain = []
    try:
        pid = os.getppid()
        for _ in range(max_depth):
            if pid <= 1:
                break
            out = subprocess.check_output(
                ["ps", "-p", str(pid), "-o", "ppid=,command="],
                text=True, timeout=1,
            ).strip()
            if not out:
                break
            parts = out.split(maxsplit=1)
            if len(parts) < 2:
                break
            ppid_str, cmdline = parts
            toks = cmdline.split()
            short = None
            for tok in toks:
                if tok.endswith((".py", ".sh")):
                    short = Path(tok).name
                    break
            if not short:
                short = Path(toks[0]).name if toks else "?"
            chain.append(short)
            try:
                pid = int(ppid_str)
            except ValueError:
                break
    except Exception:
        pass
    return chain


def machine_tag():
    """Short machine label, matching the convention in the global CLAUDE.md."""
    try:
        name = subprocess.check_output(
            ["scutil", "--get", "ComputerName"], text=True, timeout=1
        ).strip()
    except Exception:
        name = socket.gethostname()
    lower = name.lower()
    if "studio" in lower: return "Studio"
    if "macbook" in lower or "mbp" in lower: return "MBP"
    if "remote" in lower: return "RemoteMac"
    return name


def classify_error(exit_code: int, stderr_tail: str) -> str:
    """Categorize the call result by exit_code + stderr text.

    Auth-failure detection happens separately on stdout (see is_auth_failure)
    because the CLI returns exit 0 + JSON-shaped success envelope with
    `is_error:true` on auth lapse — exit_code alone never sees it.
    """
    if exit_code == 0:
        return "ok"
    if "command not found" in stderr_tail or "No such file" in stderr_tail:
        return "cli_missing"
    lower = stderr_tail.lower()
    if "rate" in lower and "limit" in lower:
        return "rate_limit"
    if "timed out" in lower or "timeout" in lower:
        return "timeout"
    return "nonzero"


# Exit code for auth-failure suppression. Picked 78 (sysexits EX_CONFIG) so
# callers can distinguish "auth lapsed, nothing to do but /login" from a real
# CLI crash. Most callers just check `returncode != 0` and fall through to
# their own error path, which is the desired fail-closed behavior.
AUTH_FAILURE_EXIT = 78
AUTH_FAILURE_MARKER = "Not logged in"
API_AUTH_FAILURE_MARKER = "Failed to authenticate. API Error: 401"


def is_api_auth_failure(stdout_bytes: bytes, stderr_bytes: bytes) -> bool:
    """Detect the server-side 401 rejection shape.

    Distinct from `is_auth_failure` (the CLI's "Not logged in" JSON envelope):
    here the CLI thinks it has credentials, submits them, and the API rejects
    them with HTTP 401. The CLI prints
        Failed to authenticate. API Error: 401 Invalid authentication credentials
    to stdout (sometimes stderr) and exits non-zero.

    Triggers on 2026-05-18: every claude -p call from the screenshot renamer
    started returning this after the token was revoked server-side ~6 hours
    into its 8-hour lifetime. Confirmed by rename.log entries with
    stderr='' stdout='Failed to authenticate. API Error: 401 ...'.
    """
    for buf in (stdout_bytes, stderr_bytes):
        if not buf:
            continue
        text = buf.decode("utf-8", errors="ignore")
        if API_AUTH_FAILURE_MARKER in text:
            return True
    return False


def is_auth_failure(stdout_bytes: bytes) -> bool:
    """Detect either unauthenticated-CLI shape.

    Shape 1 — JSON envelope (CLI thinks it has creds, then realizes they are bad):
        {"type":"result","subtype":"success","is_error":true,
         "result":"Not logged in · Please run /login",
         "stop_reason":"stop_sequence","total_cost_usd":0,
         "usage":{"input_tokens":0,...},...}

    Shape 2 — plain text (CLI has no credentials file at all, prints
    "Not logged in · Please run /login" to stdout and exits non-zero).
    The "· Please run /login" suffix makes this hard to confuse with
    real model output.
    """
    if not stdout_bytes:
        return False
    text = stdout_bytes.decode("utf-8", errors="ignore").strip()

    # Shape 2: plain-text fallback
    if text.startswith("Not logged in · Please run /login"):
        return True

    # Shape 1: JSON envelope
    if not text.startswith("{"):
        return False
    try:
        data = json.loads(text)
    except Exception:
        return False
    if not isinstance(data, dict):
        return False
    if not data.get("is_error"):
        return False
    result = data.get("result") or ""
    if not isinstance(result, str) or not result.startswith(AUTH_FAILURE_MARKER):
        return False
    usage = data.get("usage") or {}
    if isinstance(usage, dict) and usage.get("input_tokens", 0) > 0:
        return False
    return True


def maybe_alert_auth_failure(machine: str, mode: str = "cli") -> None:
    """Send at most one auth-failure email per hour per machine per mode.

    `mode` is "cli" for the "Not logged in" JSON envelope (CLI thinks it has
    no credentials) or "api" for the server-side 401 rejection (CLI has
    credentials, API rejected them). They are tracked separately because
    they have different fixes: cli mode = /login on the machine. api mode =
    /login OR wait for a token-revocation issue to clear (rate limit,
    concurrent-session invalidation, expired refresh chain).

    Quiet on disk if alerter can't reach Resend — the stderr line is the
    user-visible signal.
    """
    key = current_hour_key()
    flag = Path(f"/tmp/claude-p-auth-alert-{machine}-{mode}")
    try:
        if flag.exists() and flag.read_text().strip() == key:
            return
    except Exception:
        pass
    try:
        flag.write_text(key)
    except Exception:
        pass
    if mode == "api":
        subject = f"[claude-p] API 401 on {machine} — token rejected"
        body = (
            f"`claude -p` on {machine} is hitting HTTP 401 from the API:\n"
            f'    Failed to authenticate. API Error: 401 Invalid authentication credentials\n\n'
            "The CLI has credentials but the server is rejecting them. "
            "Common causes: token revoked by a concurrent login on another "
            "machine, rate-limit-driven invalidation, or a refresh token "
            "that lost its chain.\n\n"
            "Fix: open Terminal on that machine and run:\n"
            "  claude /login\n\n"
            "Until then, every claude-p call from that machine is exiting "
            "with code 78 (api_auth_failure).\n"
        )
    else:
        subject = f"[claude-p] auth lapsed on {machine}"
        body = (
            f"`claude -p` on {machine} is returning is_error:true with "
            f'result="Not logged in · Please run /login".\n\n'
            "Open Terminal on that machine and run:\n"
            "  claude /login\n\n"
            "Until then, every claude-p call from that machine is "
            "exiting with code 78 (auth_failure). Any caller that "
            "ignored exit codes and consumed `result` would have "
            "captured the 'Not logged in' string as a result.\n"
        )
    try:
        send_alert_email(subject=subject, body=body)
    except Exception:
        pass
    # Reactive auto-fix: also kickstart the computer-use-local claude-login
    # LaunchAgent (com.cc.claude-login-refresh). It runs the OAuth automation
    # end-to-end on the GUI user session and refreshes ~/.claude/.credentials.json
    # without human input. Throttled the same as the email (one per hour per
    # machine per mode) since both are gated by the flag-file above.
    try:
        if platform.system() == "Darwin":
            uid = os.getuid()
            subprocess.run(
                ["launchctl", "kickstart", "-k",
                 f"gui/{uid}/com.cc.claude-login-refresh"],
                capture_output=True,
                timeout=5,
            )
    except Exception:
        pass


def main():
    args = sys.argv[1:]
    caller = detect_caller()
    sid = (
        os.environ.get("CLAUDE_SESSION_ID")
        or os.environ.get("CLAUDECODE_SESSION_ID")
        or os.environ.get("SID")
        or ""
    )[:8] or "none"

    call_id = uuid.uuid4().hex[:12]
    now_iso = datetime.now(LOG_TZ).isoformat()

    # Count BEFORE the call to get the post-increment value
    count = increment_count()

    # Fire alert if we just crossed a threshold
    maybe_alert(count, caller)

    # Read stdin if piped + measure argv
    stdin_data = b""
    if not sys.stdin.isatty():
        stdin_data = sys.stdin.buffer.read()
    argv_prompt = " ".join(a for a in args if not a.startswith("-"))
    argv_chars = len(argv_prompt)
    prompt_chars = len(stdin_data) + argv_chars

    # Human-readable sample for debugging (argv first, then stdin)
    preview_source = argv_prompt
    if stdin_data:
        stdin_text = stdin_data.decode("utf-8", errors="replace")
        preview_source = (argv_prompt + "\n" + stdin_text).strip() if argv_prompt else stdin_text
    prompt_preview = preview_source[:300]

    # Fingerprint the prompt for dedupe visibility
    h = hashlib.sha256()
    h.update(stdin_data)
    for a in args:
        if not a.startswith("-"):
            h.update(a.encode("utf-8", errors="replace"))
    prompt_sha = h.hexdigest()[:16]

    base_entry = {
        "ts":             now_iso,
        "call_id":        call_id,
        "wrapper_version": WRAPPER_VERSION,
        "machine":        machine_tag(),
        "caller":         caller,
        "ancestry":       process_ancestry(),
        "cwd":            os.getcwd(),
        "sid":            sid,
        "model":          parse_model(args),
        "purpose":        os.environ.get("CLAUDE_P_PURPOSE", ""),
        "prompt_chars":   prompt_chars,
        "prompt_sha":     prompt_sha,
        "prompt_preview": prompt_preview,
        "count_this_hour": count,
    }

    # Suppress if over hard limit — unless caller is on the event-driven allowlist
    if count > HARD_LIMIT and caller not in EXEMPT_CALLERS:
        log({**base_entry, "suppressed": True, "error_category": "rate_limit"})
        sys.exit(0)
    if count > HARD_LIMIT and caller in EXEMPT_CALLERS:
        base_entry["exempt"] = True

    # Find real claude binary. `which claude` works fine in an interactive
    # shell, but returns empty under launchd's stripped PATH and over
    # non-interactive SSH — both common for daemon callers like the
    # screenshot clipboard-watcher. When `which` comes up empty, probe the
    # locations Claude Code ships to in priority order. Bare "claude" is the
    # last-ditch fallback so subprocess.Popen below at least emits a clear
    # FileNotFoundError instead of silently picking the wrong binary.
    # Diagnosed 2026-05-27 when screenshot renames silently fell back to
    # Ollama on the MBP because the launchd daemon could not find claude.
    real_claude = subprocess.run(
        ["which", "claude"], capture_output=True, text=True
    ).stdout.strip()
    if not real_claude:
        for candidate in (
            Path.home() / ".local/bin/claude",
            Path("/opt/homebrew/bin/claude"),
            Path("/usr/local/bin/claude"),
            Path.home() / ".claude/local/claude",
        ):
            if candidate.exists():
                real_claude = str(candidate)
                break
    if not real_claude:
        real_claude = "claude"

    # Suppress per-call session JSONLs unless caller opts in. The whole point
    # of `claude -p` is one-shot, so persisted sessions clutter the VS Code
    # sidebar (281 stale rename entries observed 2026-05-03). CLAUDE_P_PERSIST=1
    # is the escape hatch; passing --no-session-persistence already in args
    # also wins (idempotent).
    persist_opt_in = os.environ.get("CLAUDE_P_PERSIST", "").strip().lower() in ("1", "true", "yes")
    suppress_persistence = (not persist_opt_in) and ("--no-session-persistence" not in args)
    extra_flags = ["--no-session-persistence"] if suppress_persistence else []
    base_entry["persist"] = not suppress_persistence
    cmd = [real_claude, "-p"] + extra_flags + args

    start = time.monotonic()
    stderr_buf = b""
    stdout_buf = b""
    try:
        # Capture stdout AND stderr so we can detect the auth-failure JSON
        # shape (exit 0 + is_error:true) before forwarding. Pre-Build 7 we
        # streamed stdout via inherit; that let "Not logged in" responses
        # leak straight to callers, which the namer then treated as a real
        # title. See RCA 2026-05-07.
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        stdout_buf, stderr_buf = proc.communicate(input=stdin_data)
        exit_code = proc.returncode
    except Exception as e:
        exit_code = 1
        stderr_buf = f"[claude-p] error: {e}".encode()
        sys.stderr.write(stderr_buf.decode(errors="replace") + "\n")

    # Auth-failure suppression: if the CLI's stdout JSON envelope says
    # is_error:true with "Not logged in" result, treat the call as failed
    # regardless of exit code (the CLI returns exit 1, but every caller
    # parses stdout independently of returncode and would still capture
    # the auth-error string). Forward an empty stdout, write a clear
    # stderr line, exit AUTH_FAILURE_EXIT (78) so callers fail closed.
    auth_failed = is_auth_failure(stdout_buf)
    api_auth_failed = (not auth_failed) and is_api_auth_failure(stdout_buf, stderr_buf)

    # Auto-recovery: if auth failed, pull fresh credentials from Parameter Store
    # and retry the call once. Skipped if CLAUDE_P_NO_RECOVER=1 (used by tests
    # that need to observe the raw auth-failure path).
    recovery_attempted = False
    recovery_succeeded = False
    if (auth_failed or api_auth_failed) and not os.environ.get("CLAUDE_P_NO_RECOVER"):
        pull_script = Path.home() / "apps" / "cc" / "recipes" / "claude-creds-pull.sh"
        if pull_script.exists():
            recovery_attempted = True
            try:
                pull_proc = subprocess.run(
                    ["bash", str(pull_script)],
                    capture_output=True, text=True, timeout=30,
                )
                if pull_proc.returncode == 0:
                    sys.stderr.write(
                        "[claude-p] auth lapsed; pulled fresh credentials from "
                        "Parameter Store, retrying once.\n"
                    )
                    sys.stderr.flush()
                    retry_proc = subprocess.Popen(
                        cmd,
                        stdin=subprocess.PIPE,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,
                    )
                    stdout_buf2, stderr_buf2 = retry_proc.communicate(input=stdin_data)
                    retry_exit = retry_proc.returncode
                    if not is_auth_failure(stdout_buf2) and not is_api_auth_failure(stdout_buf2, stderr_buf2):
                        stdout_buf, stderr_buf = stdout_buf2, stderr_buf2
                        exit_code = retry_exit
                        auth_failed = False
                        api_auth_failed = False
                        recovery_succeeded = True
                else:
                    sys.stderr.write(
                        f"[claude-p] auth lapsed; Parameter Store pull failed "
                        f"(rc={pull_proc.returncode}). Falling through to alert.\n"
                    )
            except Exception as e:
                sys.stderr.write(f"[claude-p] recovery error: {e}\n")

    base_entry["recovery_attempted"] = recovery_attempted
    base_entry["recovery_succeeded"] = recovery_succeeded

    if auth_failed:
        machine = machine_tag()
        sys.stderr.write(
            f"[claude-p] auth lapsed on {machine} — `claude -p` returned "
            f'is_error:true with result="Not logged in · Please run '
            f"/login\". Suppressing stdout and exiting {AUTH_FAILURE_EXIT}.\n"
            f"[claude-p] Fix: open Terminal on {machine} and run `claude "
            f"/login` to refresh the keychain credential.\n"
        )
        sys.stderr.flush()
        maybe_alert_auth_failure(machine, mode="cli")
        exit_code = AUTH_FAILURE_EXIT
    elif api_auth_failed:
        machine = machine_tag()
        sys.stderr.write(
            f"[claude-p] API 401 on {machine} — server rejected the token "
            f"with `Failed to authenticate. API Error: 401`. Suppressing "
            f"stdout and exiting {AUTH_FAILURE_EXIT}.\n"
            f"[claude-p] Fix: open Terminal on {machine} and run `claude "
            f"/login` to mint a fresh OAuth token.\n"
        )
        sys.stderr.flush()
        maybe_alert_auth_failure(machine, mode="api")
        exit_code = AUTH_FAILURE_EXIT
    else:
        # Forward stdout unchanged so callers keep getting claude's output.
        # auth_failed / api_auth_failed cases above intentionally drop stdout
        # to prevent callers from consuming the auth-error string as a result.
        if stdout_buf:
            sys.stdout.buffer.write(stdout_buf)
            sys.stdout.flush()

    # Forward stderr to our stderr so callers that grep it still see it
    if stderr_buf:
        sys.stderr.buffer.write(stderr_buf)
        sys.stderr.flush()

    elapsed = round(time.monotonic() - start, 2)
    stderr_tail = stderr_buf.decode(errors="replace")[-400:]
    error_category = (
        "auth_failure" if auth_failed
        else "api_auth_failure" if api_auth_failed
        else classify_error(exit_code, stderr_tail)
    )

    log({
        **base_entry,
        "elapsed_s":       elapsed,
        "exit_code":       exit_code,
        "stderr_tail":     stderr_tail,
        "error_category":  error_category,
    })
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
