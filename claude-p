API_AUTH_FAILURE_MARKERS = (
    API_AUTH_FAILURE_MARKER,
    "User OAuth refresh failed",
    "OAuth token refresh failed",
    # 2026-07-20: the OAuth token expired (July 14) and its refresh chain went
