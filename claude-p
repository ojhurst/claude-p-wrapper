# ── Rate tracking ─────────────────────────────────────────────────────────────

def current_hour_key() -> str:
    return datetime.now().strftime("%Y-%m-%dT%H")

AUTH_ALERT_COOLDOWN_S = 6 * 3600  # one auth-failure email per machine/mode per 6h

def get_count() -> int:
    key = current_hour_key()
    try:
        if RATE_FILE.exists():
            stored_key, n = RATE_FILE.read_text().strip().split(",", 1)
            return int(n) if stored_key == key else 0
    except Exception:
        pass
    return 0

def increment_count() -> int:
    key = current_hour_key()
    count = get_count() + 1
    try:
        RATE_FILE.write_text(f"{key},{count}")
    except Exception:
        pass
    return count

# ── Gmail alert ───────────────────────────────────────────────────────────────

def send_alert_email(subject: str, body: str):
    """Shell out to the canonical notify wrapper at gmail-notify/send-email.py.

    Replaces an earlier inline Resend POST that defaulted to a wrong sender
    (`noreply@example.com`) and a wrong recipient (`you@example.com`),
    landing alerts in the DDXWeb mailbox instead of James's primary inbox.
    The wrapper signs from `bot@example.com` and ships to
    `you@example.com` per the Notify-James Pattern SOP.

    Per SOP we do not pass the API key here — send-email.py reads RESEND_API_KEY
    from env. We keep failure surfacing identical (write to /tmp/claude-p-email.log)
    so the wrapper never crashes the host claude -p call on a transient send error.
    """
    try:
        proc = subprocess.run(
            ["python3", str(NOTIFY), "--to", ALERT_TO, "--subject", subject, "--body", body],
            capture_output=True, text=True, timeout=15,
        )
        if proc.returncode != 0:
            with open("/tmp/claude-p-email.log", "a") as f:
                f.write(
                    f"[{datetime.now(LOG_TZ).isoformat()}] notify rc={proc.returncode} "
                    f"stderr={proc.stderr.strip()[:300]!r}\n"
                )
    except Exception as e:
        try:
            with open("/tmp/claude-p-email.log", "a") as f:
                f.write(f"[{datetime.now(LOG_TZ).isoformat()}] notify failed: {e}\n")
        except Exception:
            pass

# ── Auto-diagnosis for alert emails ───────────────────────────────────────────
# When a threshold email fires it should already carry the "what" and the "how to
# fix," so James can act (or just say "fix it") without digging through logs.

# STDERR frequently carries only a cosmetic settings.json permission warning; the
# real failure ("User OAuth refresh failed …") lands on STDOUT. Skip the cosmetic
# noise so it is never mistaken for the cause.
_COSMETIC_MARKERS = ("Permission allow rule",)

# needle in stdout+stderr  ->  short tag stored as error_signature
_ERROR_SIGNATURES = (
    ("User OAuth refresh failed",              "oauth_refresh_failed"),
    ("OAuth token refresh failed",             "oauth_refresh_failed"),
    ("Failed to authenticate. API Error: 401", "api_401"),
    ("Not logged in",                          "not_logged_in"),
    ("API Error: 429",                         "rate_limited"),
    ("API Error: 529",                         "overloaded"),
    ("API Error: 500",                         "api_500"),
    ("API Error: 400",                         "api_400"),
)

_AUTH_TAGS = {"oauth_refresh_failed", "api_401", "not_logged_in",
              "api_auth_failure", "auth_failure"}


def extract_error_signature(stdout_bytes, stderr_bytes, exit_code) -> str:
    """A short, human-meaningful marker for a failed call, logged as
    `error_signature`. Scans stdout first (auth errors live there), and skips the
    cosmetic settings.json permission warning that otherwise dominates stderr."""
    if not exit_code:
        return ""
    out = (stdout_bytes or b"").decode("utf-8", errors="ignore")
    err = (stderr_bytes or b"").decode("utf-8", errors="ignore")
    combined = out + "\n" + err
    for needle, tag in _ERROR_SIGNATURES:
        if needle in combined:
            return tag
    for text in (out, err):
        for line in text.splitlines():
            line = line.strip()
            if line and not any(c in line for c in _COSMETIC_MARKERS):
                return line[:120]
    return f"exit_{exit_code}"


def diagnose_hour(caller: str) -> str:
    """Scan this hour's usage log and return a plain-English diagnosis block
    (one-sentence summary + likely cause + proposed fix) for the alert email.
    Never raises — a diagnosis failure must not block the alert."""
    try:
        key = current_hour_key()
        entries = []
        if LOG_FILE.exists():
            with open(LOG_FILE) as f:
                for line in f:
                    if key not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if str(d.get("ts", "")).startswith(key):
                        entries.append(d)
        total = len(entries)
        if not total:
            return ""

        failed = [e for e in entries
                  if e.get("exit_code") not in (0, None)
                  or e.get("error_category") not in ("ok", None)]
        fail_n = len(failed)
        fail_pct = round(100 * fail_n / total)

        callers = collections.Counter(e.get("caller", "?") for e in entries)
        top_caller, top_n = callers.most_common(1)[0]
        top_pct = round(100 * top_n / total)

        auth_hit = any(
            (e.get("error_signature") in _AUTH_TAGS)
            or (e.get("error_category") in ("api_auth_failure", "auth_failure"))
            for e in failed
        )
        top_err = next((e.get("error_signature") for e in failed
                        if e.get("error_signature")
                        and not str(e.get("error_signature")).startswith("exit_")), "")

        machine = machine_tag()
        out = ["── Auto-diagnosis ──"]
        if fail_n and fail_pct >= 50:
            out.append(
                f"{fail_n} of the last {total} calls this hour FAILED ({fail_pct}%). "
                f"{top_caller} drives {top_pct}% of the volume by retrying on failure."
            )
            if auth_hit:
                out.append(
                    "Likely cause: headless auth is down — the OAuth token expired and its "
                    "refresh is being rejected (a login on another machine can revoke the "
                    "shared token chain). Every claude -p call fails until re-login; timer "
                    "callers then retry in a loop and inflate the count."
                )
                out.append(
                    f"Proposed fix: run  claude /login  on {machine}, then  "
                    f"bash ~/apps/cc/recipes/claude-creds-publish.sh  to refresh Parameter "
                    f"Store for every machine. (Any 'Write(...settings.json)' line in stderr "
                    f"is a cosmetic permission warning — not the cause.)"
                )
            else:
                out.append(f"Likely cause: {top_caller} is erroring and retrying.")
                out.append(
                    "Proposed fix: fix the underlying error for that caller; until then it "
                    "keeps retrying. Breakdown: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1"
                )
        else:
            out.append(
                f"{top_caller} generated {top_pct}% of {total} calls this hour "
                f"({fail_n} failed) — a busy or looping caller, not an outage."
            )
            out.append(
                "Proposed fix: check that caller's cadence. "
                "Breakdown: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1"
            )
        if top_err:
            out.append(f"Top error: {top_err}")
        out.append("Callers this hour: "
                   + ", ".join(f"{c}={n}" for c, n in callers.most_common(5)))
        return "\n".join(out) + "\n"
    except Exception as e:
        return f"(auto-diagnosis unavailable: {e})\n"


def maybe_alert(count: int, caller: str):
    """Send an email alert if we just crossed a threshold — at most once per hour per tier."""
    key = current_hour_key()
    try:
        stored = ALERT_FILE.read_text().strip() if ALERT_FILE.exists() else ""
        stored_key, stored_tier = stored.split(",", 1) if "," in stored else ("", "")
    except Exception:
        stored_key, stored_tier = "", ""

    tier = None
    if count == HARD_LIMIT:
        tier = "critical"
    elif count == WARN_LIMIT:
        tier = "warning"

    if tier is None:
        return

    if stored_key == key and stored_tier == tier:
        return  # already emailed this tier this hour

    ALERT_FILE.write_text(f"{key},{tier}")

    hour_label = datetime.now().strftime("%-I %p")
    if tier == "critical":
        subject = f"[claude-p] CRITICAL: {count} calls this hour — suppressing further calls"
        body = (
            f"claude -p has been called {count} times this hour (threshold: {HARD_LIMIT}).\n\n"
            f"Caller that triggered: {caller}\n"
            f"Hour: {hour_label}\n\n"
            f"Further calls are now suppressed until the next clock-hour.\n"
            f"Run: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1\n"
            f"to see the full breakdown."
        )
    else:
        subject = f"[claude-p] WARNING: {count} calls this hour"
        body = (
            f"claude -p has been called {count} times this hour (warning threshold: {WARN_LIMIT}).\n\n"
            f"Caller that triggered: {caller}\n"
            f"Hour: {hour_label}\n\n"
            f"Calls are still proceeding. Hard limit is {HARD_LIMIT}/hour.\n"
            f"Run: python3 ~/apps/claude-p-wrapper/claude-p-report --hours 1\n"
            f"to see the full breakdown."
        )

    diag = diagnose_hour(caller)
    if diag:
        body = body + "\n" + diag

    send_alert_email(subject, body)

# ── Caller detection ──────────────────────────────────────────────────────────

def detect_caller() -> str:
    try:
        ppid = os.getppid()
        out = subprocess.check_output(
            ["ps", "-p", str(ppid), "-o", "command="], text=True, timeout=2
        ).strip()
        parts = out.split()
        for part in parts:
            if part.endswith((".py", ".sh")):
                return Path(part).name
        return parts[0] if parts else "unknown"
    except Exception:
        return "unknown"

