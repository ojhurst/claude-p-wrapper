    "OAuth session expired and could not be refreshed",
    "Failed to authenticate: OAuth session",
)


def is_api_auth_failure(stdout_bytes: bytes, stderr_bytes: bytes) -> bool:
    """Detect the server-side 401 rejection shape.

    Distinct from `is_auth_failure` (the CLI's "Not logged in" JSON envelope):
    here the CLI thinks it has credentials, submits them, and the API rejects
    them with HTTP 401. The CLI prints
        Failed to authenticate. API Error: 401 Invalid authentication credentials
    to stdout (sometimes stderr) and exits non-zero.

    Triggers on 2026-05-18: every claude -p call from the screenshot renamer
    started returning this after the token was revoked server-side ~6 hours
    into its 8-hour lifetime. Confirmed by rename.log entries with
    stderr='' stdout='Failed to authenticate. API Error: 401 ...'.
    """
    for buf in (stdout_bytes, stderr_bytes):
        if not buf:
            continue
        text = buf.decode("utf-8", errors="ignore")
        if any(m in text for m in API_AUTH_FAILURE_MARKERS):
            return True
    return False


def is_auth_failure(stdout_bytes: bytes) -> bool:
    """Detect either unauthenticated-CLI shape.

    Shape 1 — JSON envelope (CLI thinks it has creds, then realizes they are bad):
        {"type":"result","subtype":"success","is_error":true,
         "result":"Not logged in · Please run /login",
         "stop_reason":"stop_sequence","total_cost_usd":0,
         "usage":{"input_tokens":0,...},...}

    Shape 2 — plain text (CLI has no credentials file at all, prints
    "Not logged in · Please run /login" to stdout and exits non-zero).
    The "· Please run /login" suffix makes this hard to confuse with
    real model output.
    """
    if not stdout_bytes:
        return False
    text = stdout_bytes.decode("utf-8", errors="ignore").strip()

    # Shape 2: plain-text fallback
    if text.startswith("Not logged in · Please run /login"):
        return True

    # Shape 1: JSON envelope
    if not text.startswith("{"):
        return False
    try:
        data = json.loads(text)
    except Exception:
        return False
    if not isinstance(data, dict):
        return False
    if not data.get("is_error"):
        return False
    result = data.get("result") or ""
    if not isinstance(result, str) or not result.startswith(AUTH_FAILURE_MARKER):
        return False
    usage = data.get("usage") or {}
    if isinstance(usage, dict) and usage.get("input_tokens", 0) > 0:
        return False
    return True


# ── Fallback brain: serve callers when OAuth is down ───────────────────────────
# The Anthropic API key (/anthropic/api-key) is a SEPARATE credential that
# survives an OAuth outage. When `claude -p` auth fails, we answer the caller
# through claude-login's brain via that key instead of going dark. Honors
# --system-prompt / --append-system-prompt and --output-format json so callers
# that depend on those flags keep working — the exact gap that got the old SDK
# path disabled in Build 18.

CLAUDE_LOGIN_DIR = Path.home() / "apps" / "claude-login"
GRACE_MIN = 15  # hold auth alerts until an outage is sustained this long


def map_model_to_api(model_name: str) -> str:
    """Map a caller's model name to a current, valid Anthropic API model id.
    brain.py's own DEFAULT_MODEL ("claude-sonnet-4-6") is stale; pin live ids."""
    m = (model_name or "").lower()
    if "haiku" in m:  return "claude-haiku-4-5-20251001"
    if "opus" in m:   return "claude-opus-4-8"
    if "sonnet" in m: return "claude-sonnet-5"
    return "claude-sonnet-5"  # "default"/unknown — matches claude -p's default tier


def _flag_value(args, name: str):
    """Return the value of `--name val` or `--name=val` from args, else None."""
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def brain_serve(args, stdin_data: bytes, model_name: str):
    """Answer the current caller via the API-key brain. Returns stdout bytes to
    emit (plain text, or a CLI-shaped JSON envelope when --output-format json),
    or None if the brain is unavailable or the request can't be safely served."""
    out_fmt = (_flag_value(args, "--output-format") or "").lower()
    if out_fmt not in ("", "text", "json"):
        return None  # stream-json etc. — don't risk a malformed degrade
    try:
        if str(CLAUDE_LOGIN_DIR) not in sys.path:
            sys.path.insert(0, str(CLAUDE_LOGIN_DIR))
        from claude_login import brain
    except Exception:
        return None
    if not brain.available():
        return None
    argv_prompt = " ".join(a for a in args if not a.startswith("-"))
    full = argv_prompt
    if stdin_data:
        st = stdin_data.decode("utf-8", errors="replace")
        full = (argv_prompt + "\n" + st).strip() if argv_prompt else st
    if not full.strip():
        return None
    system = _flag_value(args, "--system-prompt") or _flag_value(args, "--append-system-prompt")
    try:
        text = brain.ask(full, system=system, model=map_model_to_api(model_name),
                         max_tokens=8192, timeout=90)
    except Exception:
        return None
    if not text:
        return None
    if out_fmt == "json":
        envelope = {
            "type": "result", "subtype": "success", "is_error": False,
            "result": text, "session_id": "brain-fallback", "num_turns": 1,
            "total_cost_usd": 0, "brain_fallback": True,
            "usage": {"input_tokens": 0, "output_tokens": 0},
        }
        return (json.dumps(envelope) + "\n").encode()
    return (text.rstrip("\n") + "\n").encode()


# ── Auth-failure escalation: grace-gated, PONG-verified, smart receipt ─────────

def auth_outage_minutes() -> float:
    """Minutes since the current unbroken auth-outage streak began, from the
    usage log. 0.0 when this is the first failure (nothing to page on yet)."""
    try:
        if not LOG_FILE.exists():
            return 0.0
        with LOG_FILE.open() as f:
            lines = f.readlines()[-200:]
        down = {"auth_failure", "api_auth_failure", "brain_fallback"}
        streak_start = None
        for line in reversed(lines):
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("error_category") in down:
                streak_start = d.get("ts")
                continue
            break
        if not streak_start:
            return 0.0
        start = datetime.fromisoformat(streak_start)
        return max(0.0, (datetime.now(LOG_TZ) - start).total_seconds() / 60.0)
    except Exception:
        return 0.0


def _pong_reverify() -> bool:
    """Fresh live check: does `claude -p` authenticate right now? Runs the wrapper
    in inner mode (no recovery/serve/escalate) so it can't recurse."""
    try:
        env = {**os.environ, "CLAUDE_P_INNER": "1"}
        p = subprocess.run(
            [str(Path(__file__).resolve()), "say PONG", "--model", "haiku"],
            capture_output=True, text=True, timeout=45, env=env,
        )
        return p.returncode == 0
    except Exception:
        return False


def _kickstart_login_agent() -> None:
    """Fire the async browser-login heal in the GUI session (macOS only)."""
    try:
        if platform.system() == "Darwin":
            uid = os.getuid()
            subprocess.run(
                ["launchctl", "kickstart", "-k",
                 f"gui/{uid}/com.cc.claude-login-refresh"],
                capture_output=True, timeout=5,
            )
    except Exception:
        pass


def _escalate_claude_login(machine: str, mode: str) -> bool:
    """Run claude-login's non-browser heal ladder and email the SMART receipt if
    it still can't fix it. Returns True if claude-login handled it (healed or
    emailed), False if claude-login is unavailable (caller should backstop)."""
    try:
        if str(CLAUDE_LOGIN_DIR) not in sys.path:
            sys.path.insert(0, str(CLAUDE_LOGIN_DIR))
        import claude_login
    except Exception:
        return False
    os.environ["CLAUDE_P_INNER"] = "1"  # guard any nested claude-p the ladder runs
    trigger = (
        f"`claude -p` on {machine} hit "
        + ("the 'Not logged in' envelope" if mode == "cli"
           else "a server-side 401 / dead refresh chain")
        + f", sustained past the {GRACE_MIN}m grace window. The API-key brain is "
          "serving callers in degraded mode; the OAuth login still needs a durable fix."
    )
    try:
        claude_login.heal("claude-cli", trigger=trigger,
                          allow_browser=False, email_on_fail=True)
        return True
    except Exception as e:
        sys.stderr.write(f"[claude-p] claude-login escalation error: {e}\n")
        return False


def _legacy_terse_email(machine: str, mode: str) -> None:
    """Backstop ONLY when claude-login is unavailable — never go silent."""
    if mode == "api":
        subject = f"[claude-p] API 401 on {machine} — token rejected"
        body = (f"`claude -p` on {machine} is hitting HTTP 401 and claude-login is "
                f"not reachable to send a full receipt.\n\n"
                "Fix: open Terminal on that machine and run:\n  claude /login\n")
    else:
        subject = f"[claude-p] auth lapsed on {machine}"
        body = (f"`claude -p` on {machine} is returning 'Not logged in' and "
                f"claude-login is not reachable to send a full receipt.\n\n"
                "Fix: open Terminal on that machine and run:\n  claude /login\n")
    try:
        send_alert_email(subject=subject, body=body)
    except Exception:
        pass


def handle_auth_failure(machine: str, mode: str) -> None:
    """Decide whether to page James, and do it the smart way.

    Grace-gated (no page for transient blips that self-heal), PONG-verified (a
    live re-check right before paging, so a just-healed token suppresses the
    alert), and routed through claude-login's receipt (what-it-tried, brain-
    sharpened) instead of a terse guess. One escalation per machine/mode per 6h.
    """
    flag = Path(f"/tmp/claude-p-auth-alert-{machine}-{mode}")
    try:
        if flag.exists() and (time.time() - flag.stat().st_mtime) < AUTH_ALERT_COOLDOWN_S:
            return
    except Exception:
        pass

    outage = auth_outage_minutes()
    if outage < GRACE_MIN:
        sys.stderr.write(
            f"[claude-p] auth failing ~{outage:.0f}m (<{GRACE_MIN}m grace) — holding "
            f"alert; brain is serving callers. Will page only if it stays down.\n"
        )
        return

    if _pong_reverify():
        sys.stderr.write("[claude-p] PONG re-verify passed — auth recovered, no alert.\n")
        try:
            flag.unlink()
        except Exception:
            pass
        return

    flag.touch()
    if not _escalate_claude_login(machine, mode):
        _legacy_terse_email(machine, mode)
    _kickstart_login_agent()


def extract_images(args):
    """Strip --image flags from args, return (cleaned_args, image_paths)."""
    cleaned = []
    images = []
    skip_next = False
    for i, a in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if a == "--image" and i + 1 < len(args):
            images.append(args[i + 1])
            skip_next = True
        elif a.startswith("--image="):
            images.append(a.split("=", 1)[1])
        else:
            cleaned.append(a)
    return cleaned, images


def build_image_preamble(image_paths):
    """Build prompt preamble that instructs the CLI to read image files."""
    reads = "\n".join(f"- {p}" for p in image_paths)
    return (
        f"First, use the Read tool to read each of these {len(image_paths)} image file(s) "
        f"and analyze them visually:\n{reads}\n\nThen answer the following:\n"
    )


def main():
    raw_args = sys.argv[1:]
    args, image_paths = extract_images(raw_args)
    caller = detect_caller()
    sid = (
        os.environ.get("CLAUDE_SESSION_ID")
        or os.environ.get("CLAUDECODE_SESSION_ID")
        or os.environ.get("SID")
        or ""
    )[:8] or "none"

    call_id = uuid.uuid4().hex[:12]
    now_iso = datetime.now(LOG_TZ).isoformat()

    # Count BEFORE the call to get the post-increment value
    count = increment_count()

    # Fire alert if we just crossed a threshold
    maybe_alert(count, caller)

    # Read stdin if piped + measure argv
    stdin_data = b""
    if not sys.stdin.isatty():
        stdin_data = sys.stdin.buffer.read()

    # Prepend image read instructions to stdin when --image is used
    if image_paths:
        preamble = build_image_preamble(image_paths).encode("utf-8")
        stdin_data = preamble + stdin_data

    argv_prompt = " ".join(a for a in args if not a.startswith("-"))
    argv_chars = len(argv_prompt)
    prompt_chars = len(stdin_data) + argv_chars

    # Human-readable sample for debugging (argv first, then stdin)
    preview_source = argv_prompt
    if stdin_data:
        stdin_text = stdin_data.decode("utf-8", errors="replace")
        preview_source = (argv_prompt + "\n" + stdin_text).strip() if argv_prompt else stdin_text
    prompt_preview = preview_source[:300]

    # Fingerprint the prompt for dedupe visibility
    h = hashlib.sha256()
    h.update(stdin_data)
    for a in args:
        if not a.startswith("-"):
            h.update(a.encode("utf-8", errors="replace"))
    prompt_sha = h.hexdigest()[:16]

    base_entry = {
        "ts":             now_iso,
        "call_id":        call_id,
        "wrapper_version": WRAPPER_VERSION,
        "machine":        machine_tag(),
        "caller":         caller,
        "ancestry":       process_ancestry(),
        "cwd":            os.getcwd(),
        "sid":            sid,
        "model":          parse_model(args),
        "purpose":        os.environ.get("CLAUDE_P_PURPOSE", ""),
        "prompt_chars":   prompt_chars,
        "prompt_sha":     prompt_sha,
        "prompt_preview": prompt_preview,
        "count_this_hour": count,
    }
    if image_paths:
        base_entry["image_count"] = len(image_paths)

    # Suppress if over hard limit — unless caller is on the event-driven allowlist
    if count > HARD_LIMIT and caller not in EXEMPT_CALLERS:
        log({**base_entry, "suppressed": True, "error_category": "rate_limit"})
        sys.exit(0)
    if count > HARD_LIMIT and caller in EXEMPT_CALLERS:
        base_entry["exempt"] = True

    # ── SDK path: DISABLED (Build 18) ─────────────────────────────────────
    # The SDK path (Build 15) called the Anthropic API directly but silently
    # dropped --system-prompt and --output-format flags, breaking every caller
    # that depends on them (session namer, screenshot renamer, etc.). Reverted
    # to CLI-only until the SDK path properly handles all flags.
    base_entry["sdk_fallback_reason"] = "disabled_build_18"

    # Find real claude binary. `which claude` works fine in an interactive
    # shell, but returns empty under launchd's stripped PATH and over
    # non-interactive SSH — both common for daemon callers like the
    # screenshot clipboard-watcher. When `which` comes up empty, probe the
    # locations Claude Code ships to in priority order. Bare "claude" is the
    # last-ditch fallback so subprocess.Popen below at least emits a clear
    # FileNotFoundError instead of silently picking the wrong binary.
    # Diagnosed 2026-05-27 when screenshot renames silently fell back to
    # Ollama on the MBP because the launchd daemon could not find claude.
    real_claude = subprocess.run(
        ["which", "claude"], capture_output=True, text=True
    ).stdout.strip()
    if not real_claude:
        for candidate in (
            Path.home() / ".local/bin/claude",
            Path("/opt/homebrew/bin/claude"),
            Path("/usr/local/bin/claude"),
            Path.home() / ".claude/local/claude",
        ):
            if candidate.exists():
                real_claude = str(candidate)
                break
    if not real_claude:
        real_claude = "claude"

    # Suppress per-call session JSONLs unless caller opts in. The whole point
    # of `claude -p` is one-shot, so persisted sessions clutter the VS Code
    # sidebar (281 stale rename entries observed 2026-05-03). CLAUDE_P_PERSIST=1
    # is the escape hatch; passing --no-session-persistence already in args
    # also wins (idempotent).
    persist_opt_in = os.environ.get("CLAUDE_P_PERSIST", "").strip().lower() in ("1", "true", "yes")
    suppress_persistence = (not persist_opt_in) and ("--no-session-persistence" not in args)
    extra_flags = ["--no-session-persistence"] if suppress_persistence else []
    if image_paths and "--permission-mode" not in " ".join(args):
        extra_flags += ["--permission-mode", "bypassPermissions"]
    base_entry["persist"] = not suppress_persistence
    # STREAMING MODE — opt in with CLAUDE_P_STREAM=1 or --stream.
    #
    # Default stays batch. The buffering below is not an oversight, it is the
    # fix from RCA 2026-05-07: output used to stream through by inheritance,
    # which let a "Not logged in" response reach the session namer as though it
    # were a real title. Anything that streams has to keep that guarantee.
    #
    # It does, by holding the first STREAM_GATE_BYTES back. Both auth-failure
    # shapes are tiny and arrive immediately — the CLI fails before it does any
    # model work — so a run that gets past the gate cannot be one of them, and
    # a run that ends under the gate is checked exactly as it is today.
    stream_mode = os.environ.get("CLAUDE_P_STREAM", "").strip().lower() in ("1", "true", "yes")
    if "--stream" in args:
        stream_mode = True
        args = [a for a in args if a != "--stream"]

    cmd = [real_claude, "-p"] + extra_flags + args

    start = time.monotonic()
    stderr_buf = b""
    stdout_buf = b""
    # True once bytes have actually left for the caller. After that the
    # suppression below can no longer un-send them, so it falls back to the
    # exit code, which every caller that fails closed already honours.
    streamed = False
    try:
        # Capture stdout AND stderr so we can detect the auth-failure JSON
        # shape (exit 0 + is_error:true) before forwarding. Pre-Build 7 we
        # streamed stdout via inherit; that let "Not logged in" responses
        # leak straight to callers, which the namer then treated as a real
        # title. See RCA 2026-05-07.
        # CLAUDE_P_AUTOMATION lets the interactive output-shaping hooks
        # (timestamp banner, context bar, commit-status line, model tag) detect
        # a headless call and skip themselves, keeping output strict for parsers.
        env = {**os.environ, "CLAUDE_NONINTERACTIVE": "1", "CLAUDE_P_AUTOMATION": "1"}
        # Machine-local long-lived token (claude setup-token, 1-year lifetime).
        # If ~/.claude/oauth-token exists, it wins over .credentials.json — this
        # frees headless boxes (VPS) from the MBP keychain-harvest sync chain.
        # Backup copy: Parameter Store /claude/vps/CLAUDE_CODE_OAUTH_TOKEN.
        token_file = Path.home() / ".claude" / "oauth-token"
        if "CLAUDE_CODE_OAUTH_TOKEN" not in env and token_file.exists():
            lt = token_file.read_text().strip()
            if lt.startswith("sk-ant-") and len(lt) > 80:
                env["CLAUDE_CODE_OAUTH_TOKEN"] = lt
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
        )
        if not stream_mode:
            stdout_buf, stderr_buf = proc.communicate(input=stdin_data)
        else:
            # stderr on its own thread. It is small, and reading both pipes
            # from one thread is the classic way to deadlock on a full buffer.
            err_chunks = []
            def drain_stderr():
                try:
                    for chunk in iter(lambda: proc.stderr.read(4096), b""):
                        err_chunks.append(chunk)
                except Exception:
                    pass
            t = threading.Thread(target=drain_stderr, daemon=True)
            t.start()

            try:
                if stdin_data:
                    proc.stdin.write(stdin_data)
                proc.stdin.close()
            except Exception:
                pass

            held = bytearray()
            out_chunks = []
            # readline, not `for line in proc.stdout` — iterating a pipe adds a
            # read-ahead buffer that would undo the whole point of this branch.
            for line in iter(proc.stdout.readline, b""):
                out_chunks.append(line)
                if streamed:
                    sys.stdout.buffer.write(line)
                    sys.stdout.flush()
                    continue
                held += line
                if len(held) >= STREAM_GATE_BYTES:
                    # Past the gate: too big to be an auth envelope. Release.
                    sys.stdout.buffer.write(bytes(held))
                    sys.stdout.flush()
                    held = bytearray()
                    streamed = True
            stdout_buf = b"".join(out_chunks)
            t.join(timeout=5)
            stderr_buf = b"".join(err_chunks)
            # Ended under the gate — nothing has been sent, so the checks below
            # still get their veto, exactly as in batch mode.
            if not streamed and held:
                pending_stdout = bytes(held)
            else:
                pending_stdout = b""
        exit_code = proc.returncode if proc.returncode is not None else proc.wait()
    except Exception as e:
        exit_code = 1
        stderr_buf = f"[claude-p] error: {e}".encode()
        sys.stderr.write(stderr_buf.decode(errors="replace") + "\n")

    # Auth-failure suppression: if the CLI's stdout JSON envelope says
    # is_error:true with "Not logged in" result, treat the call as failed
    # regardless of exit code (the CLI returns exit 1, but every caller
    # parses stdout independently of returncode and would still capture
    # the auth-error string). Forward an empty stdout, write a clear
    # stderr line, exit AUTH_FAILURE_EXIT (78) so callers fail closed.
    auth_failed = is_auth_failure(stdout_buf)
    api_auth_failed = (not auth_failed) and is_api_auth_failure(stdout_buf, stderr_buf)

    # Auto-recovery: if auth failed, pull fresh credentials from Parameter Store
    # and retry the call once. Skipped if CLAUDE_P_NO_RECOVER=1 (used by tests
    # that need to observe the raw auth-failure path).
    # Inner mode: a nested claude-p spawned by the recovery/escalation path
    # itself (PONG re-verify, claude-login's heal ladder). It must behave like
    # plain `claude -p` — no recovery, no brain-serve, no escalation — or it
    # would recurse. The outer process sets CLAUDE_P_INNER before spawning.
    inner = bool(os.environ.get("CLAUDE_P_INNER"))

    recovery_attempted = False
    recovery_succeeded = False
    if (auth_failed or api_auth_failed) and not inner and not os.environ.get("CLAUDE_P_NO_RECOVER"):
        pull_script = Path.home() / "apps" / "cc" / "recipes" / "claude-creds-pull.sh"
        if pull_script.exists():
            recovery_attempted = True
            try:
                pull_proc = subprocess.run(
                    ["bash", str(pull_script)],
                    capture_output=True, text=True, timeout=30,
                )
                if pull_proc.returncode == 0:
                    sys.stderr.write(
                        "[claude-p] auth lapsed; pulled fresh credentials from "
                        "Parameter Store, retrying once.\n"
                    )
                    sys.stderr.flush()
                    retry_proc = subprocess.Popen(
                        cmd,
                        stdin=subprocess.PIPE,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,
                        env=env,
                    )
                    stdout_buf2, stderr_buf2 = retry_proc.communicate(input=stdin_data)
                    retry_exit = retry_proc.returncode
                    if not is_auth_failure(stdout_buf2) and not is_api_auth_failure(stdout_buf2, stderr_buf2):
                        stdout_buf, stderr_buf = stdout_buf2, stderr_buf2
                        exit_code = retry_exit
                        auth_failed = False
                        api_auth_failed = False
                        recovery_succeeded = True
                else:
                    sys.stderr.write(
                        f"[claude-p] auth lapsed; Parameter Store pull failed "
                        f"(rc={pull_proc.returncode}). Falling through to alert.\n"
                    )
            except Exception as e:
                sys.stderr.write(f"[claude-p] recovery error: {e}\n")

    base_entry["recovery_attempted"] = recovery_attempted
    base_entry["recovery_succeeded"] = recovery_succeeded

    # Fallback brain: if OAuth is still down, serve THIS caller via the API-key
    # brain (a credential that survives the outage) so it gets a real answer
    # instead of a failure. Skipped in inner mode to prevent recursion.
    served_by_brain = False
    brain_out = None
    if (auth_failed or api_auth_failed) and not inner:
        try:
            brain_out = brain_serve(args, stdin_data, parse_model(args))
        except Exception:
            brain_out = None
        served_by_brain = brain_out is not None
    base_entry["brain_fallback"] = served_by_brain

    if auth_failed or api_auth_failed:
        machine = machine_tag()
        mode = "cli" if auth_failed else "api"
        if served_by_brain:
            # Degraded mode: real answer via the API-key brain, exit clean.
            sys.stdout.buffer.write(brain_out)
            sys.stdout.flush()
            sys.stderr.write(
                f"[claude-p] OAuth down on {machine} — served this call via the "
                f"API-key brain (degraded mode). The login still needs a durable fix.\n"
            )
            exit_code = 0
        else:
            # No brain available — fail closed so callers don't consume the
            # auth-error string as a result.
            sys.stderr.write(
                f"[claude-p] {'auth lapsed' if auth_failed else 'API 401'} on "
                f"{machine} — suppressing stdout and exiting {AUTH_FAILURE_EXIT} "
                f"(brain fallback unavailable). Fix: run `claude /login`.\n"
            )
            exit_code = AUTH_FAILURE_EXIT
        sys.stderr.flush()
        if not inner:
            # Grace-gated, PONG-verified, smart-receipt escalation.
            try:
                handle_auth_failure(machine, mode)
            except Exception as e:
                sys.stderr.write(f"[claude-p] escalation error: {e}\n")
    else:
        # Forward stdout unchanged so callers keep getting claude's output.
        # In streaming mode everything past the gate already went out; only the
        # held-back remainder of a short run is still owed.
        remaining = stdout_buf if not stream_mode else (
            b"" if streamed else locals().get("pending_stdout", stdout_buf))
        if remaining:
            sys.stdout.buffer.write(remaining)
            sys.stdout.flush()

    # Forward stderr to our stderr so callers that grep it still see it
    if stderr_buf:
        sys.stderr.buffer.write(stderr_buf)
        sys.stderr.flush()

    elapsed = round(time.monotonic() - start, 2)
    stderr_tail = stderr_buf.decode(errors="replace")[-400:]
    error_category = (
        "brain_fallback" if served_by_brain
        else "auth_failure" if auth_failed
        else "api_auth_failure" if api_auth_failed
        else classify_error(exit_code, stderr_tail)
    )

    entry = {
        **base_entry,
        "backend":         "cli",
        "elapsed_s":       elapsed,
        "exit_code":       exit_code,
        "stderr_tail":     stderr_tail,
        "error_category":  error_category,
    }
    error_signature = extract_error_signature(stdout_buf, stderr_buf, exit_code)
    if error_signature:
        entry["error_signature"] = error_signature
    log(entry)
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
