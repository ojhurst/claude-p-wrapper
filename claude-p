def parse_model(args):
    """Extract --model value from argv, or return 'default'."""
    for i, a in enumerate(args):
        if a == "--model" and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--model="):
            return a.split("=", 1)[1]
    return "default"


def process_ancestry(max_depth=6):
    """Walk up the process tree. Returns a list of short command names
    from parent → ancestor, e.g. ['nudge_ai_classify.py', 'nudge-clear-on-stop.sh', 'claude']."""
    chain = []
    try:
        pid = os.getppid()
        for _ in range(max_depth):
            if pid <= 1:
                break
            out = subprocess.check_output(
                ["ps", "-p", str(pid), "-o", "ppid=,command="],
                text=True, timeout=1,
            ).strip()
            if not out:
                break
            parts = out.split(maxsplit=1)
            if len(parts) < 2:
                break
            ppid_str, cmdline = parts
            toks = cmdline.split()
            short = None
            for tok in toks:
                if tok.endswith((".py", ".sh")):
                    short = Path(tok).name
                    break
            if not short:
                short = Path(toks[0]).name if toks else "?"
            chain.append(short)
            try:
                pid = int(ppid_str)
            except ValueError:
                break
    except Exception:
        pass
    return chain


def machine_tag():
    """Short machine label, matching the convention in the global CLAUDE.md."""
    try:
        name = subprocess.check_output(
            ["scutil", "--get", "ComputerName"], text=True, timeout=1
        ).strip()
    except Exception:
        name = socket.gethostname()
    lower = name.lower()
    if "studio" in lower: return "Studio"
    if "macbook" in lower or "mbp" in lower: return "MBP"
    if "remote" in lower: return "RemoteMac"
    return name


def classify_error(exit_code: int, stderr_tail: str) -> str:
    """Categorize the call result by exit_code + stderr text.

    Auth-failure detection happens separately on stdout (see is_auth_failure)
    because the CLI returns exit 0 + JSON-shaped success envelope with
    `is_error:true` on auth lapse — exit_code alone never sees it.
    """
    if exit_code == 0:
        return "ok"
    if "command not found" in stderr_tail or "No such file" in stderr_tail:
        return "cli_missing"
    lower = stderr_tail.lower()
    if "rate" in lower and "limit" in lower:
        return "rate_limit"
    if "timed out" in lower or "timeout" in lower:
        return "timeout"
    return "nonzero"


# Exit code for auth-failure suppression. Picked 78 (sysexits EX_CONFIG) so
# callers can distinguish "auth lapsed, nothing to do but /login" from a real
# CLI crash. Most callers just check `returncode != 0` and fall through to
# their own error path, which is the desired fail-closed behavior.
CREDS_FILE = Path.home() / ".claude" / ".credentials.json"

SDK_MODEL_MAP = {
    "default": "claude-sonnet-4-6-20250514",
    "sonnet": "claude-sonnet-4-6-20250514",
    "opus": "claude-opus-4-6-20250620",
    "haiku": "claude-haiku-4-5-20251001",
}

SDK_MAX_TOKENS = 16384


def read_oauth_token():
    """Read the OAuth access token.

    Prefers the machine-local long-lived token (~/.claude/oauth-token, from
    `claude setup-token`) over .credentials.json, mirroring the env-var
    precedence used for the CLI subprocess path.
    """
    try:
        token_file = Path.home() / ".claude" / "oauth-token"
        if token_file.exists():
            lt = token_file.read_text().strip()
            if lt.startswith("sk-ant-") and len(lt) > 80:
                return lt
    except Exception:
        pass
    try:
        with open(CREDS_FILE) as f:
            creds = json.load(f)
        token = creds.get("claudeAiOauth", {}).get("accessToken", "")
        return token if len(token) >= 50 else None
    except Exception:
        return None


def try_sdk_call(prompt: str, model: str = "default", stdin_data: bytes = b""):
    """Call the Anthropic API directly using the OAuth token.

    Returns (text, None) on success, (None, reason) on failure.
    Any failure falls through to the CLI path — this never raises.
    """
    try:
        import anthropic
    except ImportError:
        return None, "sdk_import_failed"

    token = read_oauth_token()
    if not token:
        return None, "no_token"

    model_id = SDK_MODEL_MAP.get(model, model)

    full_prompt = prompt
    if stdin_data:
        stdin_text = stdin_data.decode("utf-8", errors="replace")
        full_prompt = (prompt + "\n" + stdin_text).strip() if prompt else stdin_text

    if not full_prompt:
        return None, "empty_prompt"

    try:
        client = anthropic.Anthropic(auth_token=token)
        resp = client.messages.create(
            model=model_id,
            max_tokens=SDK_MAX_TOKENS,
            messages=[{"role": "user", "content": full_prompt}],
        )
        text = resp.content[0].text if resp.content else ""
        return text, None
    except Exception as e:
        err_type = type(e).__name__
        return None, f"sdk_{err_type}"


