#!/usr/bin/env python3
"""
claude-p-report — summarize ~/apps/claude-p-wrapper/logs/claude-p-usage.log

Usage:
  claude-p-report           # today's calls
  claude-p-report --hours 3 # last 3 hours
  claude-p-report --all     # all time
"""

import json
import sys
from collections import defaultdict
from datetime import datetime, timezone, timedelta
from pathlib import Path

LOG_FILE = Path(__file__).resolve().parent / "logs/claude-p-usage.log"

def parse_args():
    hours = 24
    if "--all" in sys.argv:
        hours = None
    elif "--hours" in sys.argv:
        idx = sys.argv.index("--hours")
        hours = int(sys.argv[idx + 1])
    return hours

def main():
    hours = parse_args()
    if not LOG_FILE.exists():
        print("No usage log yet — no calls recorded.")
        return

    cutoff = (datetime.now(timezone.utc) - timedelta(hours=hours)) if hours else None

    entries = []
    rate_limited = 0
    with LOG_FILE.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
                ts = datetime.fromisoformat(e["ts"])
                if cutoff and ts < cutoff:
                    continue
                if e.get("rate_limited"):
                    rate_limited += 1
                    continue
                entries.append(e)
            except Exception:
                pass

    if not entries:
        label = f"last {hours}h" if hours else "all time"
        print(f"No calls in {label}.")
        return

    label = f"last {hours}h" if hours else "all time"
    print(f"\nclaude -p usage — {label}")
    print(f"{'='*50}")
    print(f"Total calls : {len(entries)}")
    print(f"Rate limited: {rate_limited}")

    total_elapsed = sum(e.get("elapsed_s", 0) for e in entries)
    print(f"Total time  : {total_elapsed:.0f}s ({total_elapsed/60:.1f} min)")

    # By caller
    by_caller = defaultdict(lambda: {"calls": 0, "elapsed": 0.0})
    for e in entries:
        caller = e.get("caller", "unknown")
        by_caller[caller]["calls"] += 1
        by_caller[caller]["elapsed"] += e.get("elapsed_s", 0)

    print(f"\nBy caller (descending by calls):")
    print(f"{'Caller':<40} {'Calls':>6} {'Time':>8}")
    print(f"{'-'*40} {'-'*6} {'-'*8}")
    for caller, stats in sorted(by_caller.items(), key=lambda x: -x[1]["calls"]):
        print(f"{caller:<40} {stats['calls']:>6} {stats['elapsed']:>7.0f}s")

    # By hour
    by_hour = defaultdict(int)
    for e in entries:
        ts = datetime.fromisoformat(e["ts"]).astimezone()
        by_hour[ts.strftime("%Y-%m-%d %H:00")] += 1

    if len(by_hour) > 1:
        print(f"\nBy hour:")
        for hour, count in sorted(by_hour.items()):
            bar = "█" * min(count, 40)
            print(f"  {hour}  {count:>3}  {bar}")

    # Recent calls
    print(f"\nMost recent 10 calls:")
    print(f"{'Time':<20} {'Caller':<35} {'Chars':>6} {'Elapsed':>8}")
    print(f"{'-'*20} {'-'*35} {'-'*6} {'-'*8}")
    for e in sorted(entries, key=lambda x: x["ts"])[-10:]:
        ts = datetime.fromisoformat(e["ts"]).astimezone().strftime("%H:%M:%S")
        caller = e.get("caller", "?")[:35]
        chars = e.get("prompt_chars", 0)
        elapsed = e.get("elapsed_s", 0)
        print(f"  {ts:<18} {caller:<35} {chars:>6} {elapsed:>7.1f}s")

if __name__ == "__main__":
    main()
